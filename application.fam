App(
    appid="autocatch",
    name="PoGo Autocatch",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="autocatch_app",
    requires=["gui", "bt", "storage", "notification"],
    stack_size=4 * 1024,
    # Only AES-128 ECB is needed from aes.c
    cdefines=["CBC=0", "CTR=0"],
    sources=["*.c", "!tests"],
    fap_category="Bluetooth",
    fap_version="0.2",
    fap_icon="autocatch.png",
    fap_icon_assets="images",
    fap_description="Pokemon GO Plus emulator that catches Pokemon and spins Pokestops for you",
    fap_author="neednotapply",
    fap_weburl="https://github.com/neednotapply/Flip-Autocatch",
)
